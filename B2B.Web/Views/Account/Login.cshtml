@model LoginViewModel
@{ ViewData["Title"] = "Agent login"; }

<div class="login-wrap mx-auto mt-4">
    <div class="text-center mb-4">
        <div class="stat-icon bg-warning text-dark mx-auto mb-2" style="width:64px;height:64px;font-size:2rem"><i class="bi bi-box-seam-fill"></i></div>
        <h1 class="h3 fw-bold">Agent Portal</h1>
        <p class="text-muted">Sign in to view the catalog and place bulk orders.</p>
    </div>
    <div class="card p-4">
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="UserName" class="form-control" autofocus placeholder="e.g. agent01" />
                </div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</button>
        </form>
        <p class="small text-muted mt-3 mb-0"><i class="bi bi-shield-lock me-1"></i>Only accounts with the <b>Agent</b> role can sign in.
            The account is locked after @LockoutPolicy.MaxFailedAttempts wrong passwords.</p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

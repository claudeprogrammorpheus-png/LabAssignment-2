@model Order
@{ ViewData["Title"] = $"Order #{Model.OrderID}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Order #@Model.OrderID</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> My Orders</a>
        <a class="btn btn-primary" asp-action="Invoice" asp-route-id="@Model.OrderID" target="_blank"><i class="bi bi-printer"></i> Print invoice</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card p-3"><div class="text-muted small">Order date</div><div class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div></div></div>
    <div class="col-md-4"><div class="card p-3"><div class="text-muted small">Status</div><div class="fw-semibold">@Model.OrderStatus</div></div></div>
    <div class="col-md-4"><div class="card p-3"><div class="text-muted small">Total</div><div class="fw-bold fs-5 text-primary">@Model.TotalAmount.ToString("N0") ₫</div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>#</th><th>Item</th><th>Pack size</th><th class="text-end">Quantity</th><th class="text-end">Unit amount</th><th class="text-end">Line total</th></tr></thead>
            <tbody>
            @{ int n = 1; }
            @foreach (var d in Model.OrderDetails)
            {
                <tr><td>@(n++)</td><td class="fw-semibold">@d.Item?.ItemName</td><td class="small text-muted">@d.Item?.Size</td>
                    <td class="text-end">@d.Quantity</td><td class="text-end">@d.UnitAmount.ToString("N0")</td><td class="text-end">@d.LineTotal.ToString("N0")</td></tr>
            }
            </tbody>
            <tfoot><tr><th colspan="5" class="text-end">Total (VND)</th><th class="text-end">@Model.TotalAmount.ToString("N0")</th></tr></tfoot>
        </table>
    </div>
</div>

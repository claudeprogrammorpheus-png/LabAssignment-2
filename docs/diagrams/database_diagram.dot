digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.8, ranksep=1.6, fontname="Segoe UI", bgcolor="white"];
node [shape=plaintext, fontname="Segoe UI", fontsize=11];
edge [fontname="Segoe UI", fontsize=9, color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both];
"Agent" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Agent</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><B>🔑 AgentID</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>AgentName</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Address</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Phone</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(20)</FONT></TD></TR></TABLE>>];
"Users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><B>🔑 UserID</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UserName</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Email</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Password</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Lock</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Role</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>FailedLoginCount</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>AgentID</B> <I>(FK)</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int NULL</FONT></TD></TR></TABLE>>];
"Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><B>🔑 OrderID</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>OrderDate</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime2</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>AgentID</B> <I>(FK)</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>OrderStatus</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(20)</FONT></TD></TR></TABLE>>];
"OrderDetail" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>OrderDetail</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><B>🔑 ID</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>OrderID</B> <I>(FK)</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>ItemID</B> <I>(FK)</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Quantity</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>UnitAmount</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(18,2)</FONT></TD></TR></TABLE>>];
"Item" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1F4E79"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF2CC"><B>🔑 ItemID</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>ItemName</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Size</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">nvarchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Price</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(18,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>StockQuantity</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
"Agent" -> "Order" [xlabel="AgentID → AgentID
ON DELETE NO ACTION"];
"Agent" -> "Users" [xlabel="AgentID → AgentID
ON DELETE CASCADE"];
"Item" -> "OrderDetail" [xlabel="ItemID → ItemID
ON DELETE NO ACTION"];
"Order" -> "OrderDetail" [xlabel="OrderID → OrderID
ON DELETE CASCADE"];
}